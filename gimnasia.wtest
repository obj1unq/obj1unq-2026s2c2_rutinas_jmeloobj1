import gimnasia.*

describe "rutinas" {
	const correrEnLaPlaya = new Running(intensidad = 1.2)
	const remarEnElDelta = new Remo()
	const remarEnCaminoRemeros = new Remodecompeticion()
	const maratonBA = new Maraton(intensidad = 1.5)

	const calamardo = new Sedentaria(peso = 60)

	const bob = new Atleta(peso = 40)

//Punto 2: personas
	//const calamardo = //Una persona Sedentaria con peso 60 y tiempo de ejercicio 5
 	//const bob =  // Una persona atleta con peso 40 

//Punto 3: clubes
	//const recreo = //un predio con correrEnLaPlaya y maratonBA
	//const nautico = //un predio con remarEnElDelta y remarEnCaminoRemeros
	//const clubBarrial = //un club con recreo y nautico
//	
// PUNTO 1

method initialize(){
		correrEnLaPlaya.tiempo(5)
		maratonBA.tiempo(5)
		remarEnElDelta.tiempo(5)
		remarEnCaminoRemeros.tiempo(5)
}
	test "1.1 consulta running" {
		assert.equals(correrEnLaPlaya.caloriasconsumidas(), 360)
		correrEnLaPlaya.tiempo(90)
		assert.equals(correrEnLaPlaya.caloriasconsumidas(), 10200)

	}
	test "1.2 consulta maraton" {
		assert.equals(maratonBA.caloriasconsumidas(), 900)
		maratonBA.tiempo(90)
		assert.equals(maratonBA.caloriasconsumidas(), 25500)	
	}

	test "1.3 consulta remo" {
		assert.equals(remarEnElDelta.caloriasconsumidas(), 520)
		remarEnElDelta.tiempo(90)
		assert.equals(remarEnElDelta.caloriasconsumidas(), 9360)		
	}		

	test "1.4 consulta remo de competicion"{

		assert.equals(remarEnCaminoRemeros.caloriasconsumidas(), 510)
		remarEnCaminoRemeros.tiempo(90)
		assert.equals(remarEnCaminoRemeros.caloriasconsumidas(), 12750)	
	}
		

//Punto 2: Personas
	//ATENCION: usar el metodo truncate(3) para truncar un numero a 3 decimales
	// Ej: 1.2345.truncate(3) -> devuelve 1.234 

	test '2.1.1 test sedentario correrEnLaPlaya' {
		calamardo.rutina(correrEnLaPlaya)
		 calamardo.aplicaARutina()
		 assert.equals(59.948, calamardo.peso().truncate(3))
	} 
	test '2.1.2 test sedentario maratonBA' {
		 calamardo.rutina(maratonBA)
		 calamardo.aplicaARutina()
		 assert.equals(59.871, calamardo.peso().truncate(3))
	} 
	

	test '2.1.3 test sedentario remarEnElDelta' {
		 calamardo.rutina(remarEnElDelta)
		 calamardo.aplicaARutina()
		 assert.equals(59.925, calamardo.peso().truncate(3))
	} 
	

	test '2.1.4 test sedentario remarEnCaminoRemeros y calamardo peso 40' {
		 calamardo.rutina(remarEnCaminoRemeros)
		 calamardo.aplicaARutina()
		 assert.equals(59.927, calamardo.peso().truncate(3))


		 calamardo.peso(40)
		 assert.throwsException({ calamardo.aplicaARutina(correrEnLaPlaya) })
		calamardo.rutina(correrEnLaPlaya)
		 assert.throwsException({ calamardo.aplicaARutina(maratonBA) })
		 calamardo.rutina(maratonBA)
		 assert.throwsException({ calamardo.aplicaARutina(remarEnElDelta) })
		  calamardo.rutina(remarEnElDelta)
		 assert.throwsException({ calamardo.aplicaARutina(remarEnCaminoRemeros) })
		  calamardo.rutina(remarEnCaminoRemeros)
	} 

	test "2.2.1 test atleta running" {
		bob.rutina(correrEnLaPlaya)
		bob.aplicaARutina()
		assert.equals(39.725, bob.peso().truncate(3))
		 }

	test "2.2.2 test atleta maraton" {
		bob.rutina(maratonBA)
		bob.aplicaARutina()
		assert.equals(37.812, bob.peso().truncate(3))
	 }

	test "2.2.3 test atleta remo" {
		bob.rutina(remarEnElDelta)
		assert.throwsException({ bob.aplicaARutina() })
	}

	test "2.2.3 test atleta remo de competición" {
		bob.rutina(remarEnCaminoRemeros)
		bob.aplicaARutina()
		assert.equals(39.406, bob.peso().truncate(3))
	}
	 
//punto 3: Consultas
//	test "3.1 el mejor predio" {
//		//El mejor predio del clubBarrial para bob debería ser recreo		
//		//El mejor predio del clubBarrial para calamardo debería ser recreo		
//	}	
	
//	test "3.2 predios tranquis" {
//		//No debería haber predios tranquis en el clubBarrial para bob
//		//Los predios tranquis del clubBarrial para calamardo solo incluyen a recreo  
