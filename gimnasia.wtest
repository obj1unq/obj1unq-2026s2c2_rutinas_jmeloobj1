// PUNTO 1
	test "1.1 consulta running" {
		correrEnLaPlaya.intensidad(1.2)
		correrEnLaPlaya.tiempo(5)
		assert.equals(correrEnLaPlaya.caloriasconsumidas(), 360)
		correrEnLaPlaya.tiempo(90)
		assert.equals(correrEnLaPlaya.caloriasconsumidas(), 10200)

	}
	test "1.2 consulta maraton" {
		maratonBA.intensidad(1.5)
		maratonBA.tiempo(5)
		assert.equals(maratonBA.caloriasconsumidas(), 900)
		maratonBA.tiempo(90)
		assert.equals(maratonBA.caloriasconsumidas(), 25500)	
	}

	test "1.3 consulta remo" {
		remarEnElDelta.tiempo(5)
		assert.equals(remarEnElDelta.caloriasconsumidas(), 520)
		remarEnElDelta.tiempo(90)
		assert.equals(remarEnElDelta.caloriasconsumidas(), 9360)		
	}		

	test "1.4 consulta remo de competicion"{
		remarEnCaminoRemeros.tiempo(5)
		assert.equals(remarEnCaminoRemeros.caloriasconsumidas(), 510)
		remarEnCaminoRemeros.tiempo(90)
		assert.equals(remarEnCaminoRemeros.caloriasconsumidas(), 12750)	
	}
		

